IP_AUTH=
IP_DB_URL=
IP_GIMIE_URL=
IP_INFERENCE_URL=
IP_FAIR_LEVEL_INDICATOR=
IP_SEARCH_URL=

# Supabase. See docs/migrations/firebase-to-supabase.md for context.
#
# NEXT_PUBLIC_SUPABASE_URL    public URL of the GoTrue / PostgREST gateway
#                             (dev: http://imagingplazadev.epfl.ch:9999)
# NEXT_PUBLIC_SUPABASE_ANON_KEY  JWT signed with the Supabase JWT secret,
#                                role=anon. Safe to ship to the browser.
# SUPABASE_SERVICE_ROLE_KEY   JWT signed with the same secret, role=
#                             service_role. SERVER ONLY — bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plausible Analytics (optional). Leave NEXT_PUBLIC_PLAUSIBLE_DOMAIN empty
# to disable tracking entirely. NEXT_PUBLIC_PLAUSIBLE_CUSTOM_DOMAIN points
# at a self-hosted instance (e.g. https://analytics.imaging-plaza.epfl.ch);
# omit it to send events to plausible.io.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_CUSTOM_DOMAIN=
